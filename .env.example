# ===================================================================
# RagObot Environment Configuration Template
# Copy this file to .env and configure your local or deployment parameters:
#   copy .env.example .env     (Windows)
#   cp .env.example .env       (Linux / macOS)
# ===================================================================

# -------------------------------------------------------------------
# Deployment Environment & Server Network Configuration
# -------------------------------------------------------------------
# Set to 'production' for public deployments or 'development' for local prototyping
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Allowed CORS Origins (comma-separated or JSON list format)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# -------------------------------------------------------------------
# Developer Diagnostic Access Control (Header-Only Authentication)
# -------------------------------------------------------------------
# Shared secret key required in 'X-Dev-Key' or 'Authorization: Bearer <key>'
# to inspect raw unverified worker drafts and internal debate resolution notes
DEV_MODE_KEY=change_this_to_a_secure_random_key_in_production

# Allow dev_mode without key for local development (STRICTLY FORBIDDEN in production)
ALLOW_UNAUTHENTICATED_DEV_MODE=false

# -------------------------------------------------------------------
# Cloud Compute Matrix: Groq (Ultra-Fast LPU Engine)
# -------------------------------------------------------------------
# Optional: If unset, RagObot will automatically run local-only mode via Ollama
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=ANY_GROQ_MODEL

# Ollama Compute Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
EMBEDDING_MODEL=nomic-embed-text

# Arbiter Engine ('groq' or 'ollama')
ARBITER_ENGINE=groq
# Rolling context window budget (tokens) before trimming older dialogue pairs
MAX_CONTEXT_TOKENS=2000
# Maximum ChromaDB chunks retrieved per query
TOP_K_CHUNKS=3

# -------------------------------------------------------------------
# Speech Synthesis (Neural TTS with SAPI Fallback)
# -------------------------------------------------------------------
TTS_ENABLED=true
# High-definition Neural Voices: en-US-JennyNeural, en-US-GuyNeural, en-US-AriaNeural
TTS_VOICE=en-US-JennyNeural
TTS_RATE=0
TTS_VOLUME=100

# -------------------------------------------------------------------
# Knowledge Base & Storage Paths
# -------------------------------------------------------------------
DATA_DIR=./data
CHROMA_DIR=./data/chroma_db
