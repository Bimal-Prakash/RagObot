# RagObot Environment Configuration
# Copy this file to .env and configure your parameters

# Groq Cloud API Settings (Ultra-Fast LPU Engine)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=ANY_GROQ_MODEL

# Ollama Compute Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
EMBEDDING_MODEL=nomic-embed-text

# Arbiter Engine ('groq' or 'ollama')
ARBITER_ENGINE=groq

# Token Budget Guard (Rolling Context Window)
MAX_CONTEXT_TOKENS=2000

# Native Windows Hardware Voice (SAPI SpVoice)
TTS_ENABLED=true
TTS_RATE=0
TTS_VOLUME=100

# Knowledge Base & Vector Store
DATA_DIR=./data
CHROMA_DIR=./data/chroma_db
TOP_K_CHUNKS=3
